{
  "name": "leave-management-system",
  "version": "1.0.0",
  "description": "Production-Ready Leave Management System (MERN Stack)",
  "main": "backend/server.js",
  "scripts": {
    "postinstall": "npm --prefix backend install",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:backend && npm run test:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:frontend",
    "start": "npm --prefix backend start"
  },
  "keywords": [
    "mern",
    "leave-management",
    "express",
    "react",
    "mongodb",
    "tailwind"
  ],
  "author": "LMS Development Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
